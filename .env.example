# ==============================================================================
# Master Environment Configuration — the-one-who-rules-them-all
# Copy this file to .env and adjust values as needed: cp .env.example .env
# NEVER commit .env or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application & Botble CMS (the-one-who-dutifully-keeps)
# ------------------------------------------------------------------------------
APP_NAME="The One Who Rules Them All"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

ADMIN_DIR=admin
CMS_ENABLE_INSTALLER=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Database (MySQL 8.4)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_FORWARD_PORT=3306
DB_DATABASE=cms_db
DB_USERNAME=cms_user
DB_PASSWORD=changeme_db_password
DB_ROOT_PASSWORD=changeme_root_password

# ------------------------------------------------------------------------------
# Redis & Caching / Sessions / Queues
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_FORWARD_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# ------------------------------------------------------------------------------
# Local Development / Xdebug
# ------------------------------------------------------------------------------
XDEBUG_MODE=off
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003

# ------------------------------------------------------------------------------
# Mail (defaults to log driver for local development)
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.local"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Reserved Ports for Future Services (Docker Compose Profiles)
# ------------------------------------------------------------------------------
FE_PORT=3000
GO_PORT=8081
RUST_PORT=8082
NOSQL_PORT=8083
